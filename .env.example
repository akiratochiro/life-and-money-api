# Desenvolvimento: copie este arquivo para .env e preencha o segredo.
# O restante tem padrão para o localhost e não precisa ser definido aqui.
#
# Gere o segredo com: openssl rand -base64 32
JWT_SECRET=

# ---------------------------------------------------------------------------
# Produção: estas são as variáveis que o serviço de hospedagem precisa ter.
# Não as coloque no .env; o passo a passo está em docs/deploy.md.
#
# JWT_SECRET=                 segredo de 256 bits em base64 (outro, não o daqui)
# SPRING_DATASOURCE_URL=      jdbc:postgresql://host/banco?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
# APP_EMAIL_PROVIDER=         brevo (no dev o perfil já usa 'log', que só registra o link)
# BREVO_API_KEY=
# EMAIL_FROM=                 remetente confirmado no Brevo
# APP_FRONT_URL=              URL do front, sem barra no final
#
# REFRESH_COOKIE_SECURE e REFRESH_COOKIE_SAME_SITE já vêm com o valor de
# produção (true e Strict) e só precisam ser definidas para mudar esse padrão.
